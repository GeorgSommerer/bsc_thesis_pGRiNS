CAP <- c(20.02,17.96,17.7,12.94,12.66,11.31,16.04,21.12,15.31,15.79,14.87,14.06,12.5,13.88,13.89,12.2,13.27,13.78,15.93,12.28,9.375,18.43,18.51,13.43,9.04,18.86,10.4,16.92,24.23,15.2,16.51,17.22,19.23,14.22,9.645,10.69,17.37,15.41,13.75,16.01)
Borste <- rep(c("borste_1","borste_2","borste_3","borste_4"),each=10)
mytibble <- tibble(CAP,Borste)
ggplot(data=mytibble,aes(x=CAP,color=Borste,fill=Borste))+geom_histogram(alpha=.8,position="dodge",bins=10)+xlab("CAP (µV)")+ggtitle("Histogramm der CAPs der vier verschiedenen Borsten")
